{
  "name": "cotitrama",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.15.0 <25" },
  "scripts": {
    "test": "node --test \"services/**/*.test.mjs\" tools/aws-smoke.test.mjs tools/plan-development.test.mjs tools/quota-smoke.test.mjs tools/pilot-metrics-smoke.test.mjs tools/interest-smoke.test.mjs tools/pilot-interest-development.test.mjs tools/pilot-reviewer-development.test.mjs tools/applications-smoke.test.mjs",
    "test:web": "npm --prefix web test -- --watch=false",
    "test:package": "node --test tools/package-web.test.mjs",
    "build": "npm --prefix web run build && node tools/package-web.mjs",
    "demo": "node tools/demo.mjs",
    "smoke:ssr": "node tools/smoke-ssr.mjs",
    "smoke:aws:development": "node --use-system-ca tools/aws-smoke.mjs --verify",
    "cleanup:aws:development": "node --use-system-ca tools/aws-smoke.mjs --cleanup",
    "smoke:quotas:development": "node --use-system-ca tools/quota-smoke.mjs --verify",
    "cleanup:quotas:development": "node --use-system-ca tools/quota-smoke.mjs --cleanup",
    "smoke:metrics:development": "node --use-system-ca tools/pilot-metrics-smoke.mjs --verify",
    "cleanup:metrics:development": "node --use-system-ca tools/pilot-metrics-smoke.mjs --cleanup",
    "smoke:interest:development": "node --use-system-ca tools/interest-smoke.mjs --verify",
    "cleanup:interest:development": "node --use-system-ca tools/interest-smoke.mjs --cleanup",
    "smoke:applications:development": "node --use-system-ca tools/applications-smoke.mjs --verify",
    "cleanup:applications:development": "node --use-system-ca tools/applications-smoke.mjs --cleanup",
    "pilot": "node tools/pilot.mjs"
  }
}
